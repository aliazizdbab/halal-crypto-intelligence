# ==============================================================================
# Halal Crypto Intelligence & Investment Analytics Platform
# Environment Configuration (NEVER commit .env.local to version control)
# ==============================================================================

# Database file path (relative to project root or absolute)
DATABASE_PATH=./data/halal-crypto.sqlite

# Binance Public Spot API (Read-only public market data; no API key required)
BINANCE_API_BASE_URL=https://api.binance.com
BINANCE_API_FALLBACK_URL=https://data-api.binance.vision
# Optional read-only Binance API Key (NEVER grant trading or withdrawal permissions)
# BINANCE_READONLY_API_KEY=

# Optional CoinGecko Demo / Pro API Key (public free tier works without key)
# COINGECKO_API_KEY=

# Optional GitHub Personal Access Token (increases GitHub dev activity rate limit)
# GITHUB_TOKEN=

# Optional AI Research Assistant Provider (gemini | openai | ollama)
# Without a key, the built-in deterministic evidence-backed research engine works immediately.
AI_PROVIDER=gemini
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Optional Telegram Bot Notifications
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
